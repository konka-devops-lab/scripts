FROM eclipse-temurin:17-jdk

# Install Maven 3.9 (different package name)
RUN apt-get update && apt-get install -y maven

# Verify Maven version
RUN mvn --version

# Install Sonar Scanner
RUN wget -q https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-5.0.1.3006-linux.zip && \
    unzip -q sonar-scanner-cli-5.0.1.3006-linux.zip -d /opt && \
    rm sonar-scanner-cli-5.0.1.3006-linux.zip && \
    ln -s /opt/sonar-scanner-5.0.1.3006-linux/bin/sonar-scanner /usr/local/bin/sonar-scanner

# Install OWASP Dependency Check
RUN wget -q https://github.com/jeremylong/DependencyCheck/releases/download/v9.0.9/dependency-check-9.0.9-release.zip && \
    unzip -q dependency-check-9.0.9-release.zip -d /opt && \
    rm dependency-check-9.0.9-release.zip && \
    ln -s /opt/dependency-check/bin/dependency-check.sh /usr/local/bin/dependency-check

# Install Trivy
RUN wget -q https://github.com/aquasecurity/trivy/releases/download/v0.49.1/trivy_0.49.1_Linux-64bit.tar.gz && \
    tar -xzf trivy_0.49.1_Linux-64bit.tar.gz && \
    mv trivy /usr/local/bin/ && \
    rm trivy_0.49.1_Linux-64bit.tar.gz

# Install Docker CLI
RUN apt-get install -y docker.io

WORKDIR /app

CMD ["/bin/bash"]